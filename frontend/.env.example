VITE_API_BASE_URL=http://localhost:5000/api
VITE_API_URL=http://localhost:5000
VITE_API_TIMEOUT_MS=15000
VITE_UPLOAD_TIMEOUT_MS=30000
VITE_VIDEO_UPLOAD_TIMEOUT_MS=120000
VITE_RAZORPAY_KEY_ID=rzp_test_or_live_key_id

# Use the same Google OAuth 2.0 Web client ID as backend GOOGLE_CLIENT_ID.
VITE_GOOGLE_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com

# Optional but recommended for production WebRTC voice/video across mobile networks and strict NAT.
# Example: turn:turn.example.com:3478,turns:turn.example.com:5349
VITE_TURN_URLS=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
